{
  "name": "ledgerly-desktop",
  "version": "0.1.0",
  "private": true,
  "main": "desktop/main.cjs",
  "scripts": {
    "start": "electron .",
    "test": "python3 -m unittest test_server.py",
    "package:win": "electron-builder --win nsis",
    "package:mac": "electron-builder --mac dmg"
  },
  "devDependencies": {
    "electron": "^35.0.0",
    "electron-builder": "^26.0.0"
  },
  "build": {
    "appId": "com.ledgerly.desktop",
    "productName": "Ledgerly",
    "files": [
      "desktop/**",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "backend-dist/",
        "to": "backend"
      }
    ],
    "win": {
      "target": "nsis"
    },
    "mac": {
      "target": "dmg",
      "category": "public.app-category.business"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
